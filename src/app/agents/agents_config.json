[
  {
    "name": "knowledge_agent",
    "description": "Handles knowledge-based queries. This agent responds to queries about concepts, definitions, policy ",
    "prompt_file": "knowledge_agent.md",
    "tools": ["knowledge_retrieval"]
  },
  {
    "name": "form_population_agent",
    "description": "Handles form population requests, this agent can update the form based on user provided data",
    "prompt_file": "form_population_agent.md",
    "tools": [],
    "children": [
      {
        "name": "personal_details_agent",
        "description": "get/create/read/update/delete applicants (personal details).",
        "prompt_file": "form_population_agent/personal_details_agent.md",
        "context": [
          {
            "property_name": "applicants_formatted",
            "property_placeholder": "<<APPLICANTS>>"
          },
          {
            "property_name": "user_name",
            "property_placeholder": "<<CURRENTUSER>>"
          }
        ],
        "tools": [
          "GetApplicants",
          "GetApplicant",
          "CreateApplicant",
          "UpdateApplicant",
          "DeleteApplicant"
